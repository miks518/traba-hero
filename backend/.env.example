# Trabahero backend configuration.
# Copy to .env and fill in. Every blank is a valid value: it means "not set".

HOST=0.0.0.0
PORT=8010
# Not 8000 on purpose. opencode ships a vLLM provider pinned to
# http://127.0.0.1:8000 whose discovery calls /health then /v1/models on a
# timer; a backend on 8000 answers the first and 404s the second, forever.

# ── AI provider ────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Keys: https://openrouter.ai/keys
# Models: https://openrouter.ai/models — image scans need a vision model.
AI_API_KEY=
AI_API_URL=https://openrouter.ai/api/v1

# Exact model ID from the provider's list, e.g. deepseek/deepseek-flash-latest
MODEL_NAME=
# Per-endpoint model overrides. Blank uses MODEL_NAME for everything.
# The scan wants prose in a labelled format; verification wants a JSON object
# matching a schema, which fewer models can do. Worth setting when a model's
# verification call keeps falling back to text — see the 404 fallback under
# lm_client.py in AGENTS.md.
AI_MODEL_SCAN=
AI_MODEL_VERIFY=

# false only if your endpoint already injects the system prompt
SEND_SYSTEM_PROMPT=true

# ── Generation ─────────────────────────────────────────────────────────────
# 0.0 deterministic, 1.0+ creative
AI_TEMPERATURE=0
# Nucleus sampling, 0.1 - 1.0
AI_TOP_P=0.1

# Answer length ceiling. On a reasoning model the thinking is drawn from this
# same budget, so a long think can spend all of it and return nothing. Raise it
# rather than lowering it to fit.
AI_MAX_TOKENS=16384
# Per-endpoint budgets. Blank uses AI_MAX_TOKENS. Raise the verify one if
# verification answers get cut off mid-sentence.
AI_MAX_TOKENS_SCAN=16384
AI_MAX_TOKENS_VERIFY=32768

# Reasoning models only — blank sends nothing. In order of preference:
#   AI_REASONING_ENABLED=false  turn thinking off entirely (cleanest; not all
#                               models allow it)
#   AI_REASONING_EFFORT=low     less thinking, at the source
#   AI_REASONING_MAX_TOKENS=N   caps it, but a truncated think can make some
#                               providers retry, so prefer the two above
# AI_REASONING_ENABLED=false also overrides the other two, since a provider
# rejects disabled reasoning combined with a high effort level.
AI_REASONING_ENABLED=false
AI_REASONING_MAX_TOKENS=0
AI_REASONING_EFFORT=low

# ── Web search provider ─────────────────────────────────────────────────────
# Which search provider to use. Supported: "tavily", "keeenable".
# Blank defaults to "tavily" for backward compatibility.
SEARCH_PROVIDER=tavily

# ── Tavily (default) ────────────────────────────────────────────────────────
# Free tier: https://tavily.com — 1,000 credits/month, no card needed.
# One search per verification. Without a key, verification reports a search
# failure rather than a clean employer.
TAVILY_API_KEY=

# Results per search. Free in credits (cost is per request, not per result) —
# but every result is context the AI has to fit in, so raise it alongside
# AI_MAX_TOKENS.
TAVILY_MAX_RESULTS=3

# basic = 1 credit per search. advanced = 2.
# A verification runs ONE anchor search plus up to two follow-ups (see
# VERIFY_SEARCH_MODE below), so the ceiling is 3 credits at the default — or 1
# when no follow-up is planned. Setting advanced here doubles every one of
# those requests.
# basic finds small employers that only appear on a city PESO page or a local
# job board. Use advanced if recall matters more than volume.
TAVILY_SEARCH_DEPTH=basic

# How /api/verify chooses its queries. Two values:
#
#   fixed    — the employer-name query, plus up to two the scan model proposed.
#              All fired at once, before anything is known about what came back.
#   adaptive — the same anchor query, then a planner in
#              app/services/scanner/search_planner.py chooses up to two
#              follow-ups from what Round 1 actually returned. Same 3-credit
#              ceiling; most verifications spend 1.
#
# LEAVE THIS AT `fixed`. The planner is built and tested, but it has not been
# shown to produce better verdicts — that is a question for live runs, and no
# fixture has answered it yet. Anything unrecognised is read as `fixed` rather
# than as `adaptive`, so a typo costs the new behaviour rather than changing how
# many credits a verification spends.
# Design: docs/superpowers/specs/2026-10-18-adaptive-verification-search.md
VERIFY_SEARCH_MODE=fixed

# Country boost. Prioritises that country without restricting results to it,
# which is what surfaces local job boards and government pages. Blank disables
# it.
TAVILY_COUNTRY=philippines

# Domains to drop, comma or space separated. Blank excludes nothing.
# Wikipedia is the only default: an encyclopedia entry is crowd-edited and
# unattributed, so it is not a source you can cite.
# Add a domain when it crowds out a real result. Do not add jobstreet.com,
# indeed.com, or a peso.gov.ph page — those are what the boost is for.
TAVILY_EXCLUDE_DOMAINS=wikipedia.org

# ── Keenable (alternative) ──────────────────────────────────────────────────
# Sign up: https://keeenable.com — check their pricing for credits.
KEENABLE_API_KEY=

# Results per search. Configure based on Keenable's pricing.
KEENABLE_MAX_RESULTS=3

# Search depth: "basic" or "advanced". Depends on Keenable's API.
KEENABLE_SEARCH_DEPTH=advanced
# Keenable has no country-ranking parameter, so this is appended to queries
# that do not already name it. Blank disables the suffix.
KEENABLE_COUNTRY=philippines

# ── Access ─────────────────────────────────────────────────────────────────
# Blank disables auth (development only).

# ── Limits ────────────────────────────────────────────────────────────────
AI_MAX_CONCURRENT=2
AI_MAX_QUEUE_DEPTH=10
AI_ACQUIRE_TIMEOUT=10.0
AI_CALL_TIMEOUT=120.0

# ── Rate limiting ───────────────────────────────────────────────────────────
# Which peers may set X-Forwarded-For / X-Real-IP for the rate-limit identity,
# comma or space separated; bare IPs or CIDR blocks. Blank means trust NOBODY,
# so the identity is always the socket peer. That is the safe default, but
# behind a proxy (Railway, nginx, Cloudflare) it also puts every caller in one
# shared bucket, so the per-endpoint limits stop being per-endpoint. If this
# service sits behind a proxy, set it to that proxy's IP ranges.
TRUSTED_PROXIES=100.0.0.0/8

# ── CORS ────────────────────────────────────────────────────────────────────
# Origins allowed to read responses cross-origin, comma or space separated. The
# extension is the only legitimate caller. The ID below is permanent: it is
# derived from the public key in wxt.config.ts, so it is the same on every
# machine that unpacks this repo and the same one the Web Store will publish.
# Read it from chrome://extensions if you ever need to confirm it.
# Blank installs NO CORS middleware, which means a browser blocks every read and
# the panel cannot reach this backend. That is deliberate: the default it
# replaces was allow_origins=["*"], which let any website call this API through
# a user's browser. `*` here is refused rather than honoured.
CORS_ALLOWED_ORIGINS=chrome-extension://hdmdhiojgdoomcjfhbkidbhkifmokkop

# ── The agent's procedural limits ───────────────────────────────────────────
# Model round trips and tool calls per scan. AGENT_MAX_SEARCHES stays at 3
# because Tavily's free tier is 1,000 credits per month — the binding
# constraint in the whole system, against the provider's 1,000 requests per
# day. The loop must spend the same credits on better questions, not raise
# the ceiling.
AGENT_MAX_TURNS=4
AGENT_MAX_SEARCHES=3
AGENT_MAX_FETCHES=4
AGENT_MAX_FETCH_BYTES=200000
