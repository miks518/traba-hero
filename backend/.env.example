# Backend configuration
HOST=0.0.0.0
PORT=8000

# AI API Configuration (any OpenAI-compatible endpoint)
# Get a key at https://openrouter.ai/keys and pick a multimodal model at
# https://openrouter.ai/models (image scans require a vision-capable model).
AI_API_KEY=
AI_API_URL=https://openrouter.ai/api/v1
# Exact model ID from the provider's model list, e.g. deepseek/deepseek-flash-latest
MODEL_NAME=
# Set to false only if the endpoint already injects the system prompt
SEND_SYSTEM_PROMPT=true

# AI Generation Controls (Knobs)
# Temperature: 0.0 (strictly deterministic) to 1.0+ (creative). Default: 0.2
AI_TEMPERATURE=0.2
# Top-P (nucleus sampling): 0.1 to 1.0. Default: 1.0
AI_TOP_P=1.0
# Max tokens allowed for AI responses. Default: 2048
AI_MAX_TOKENS=2048

# SEC Philippines API (https://gwwso2.sec.gov.ph/companyinformationlookup/1.0.0)
# Free "Company Information Lookup" subscription: https://portal.sec.gov.ph/
SEC_API_URL=https://gwwso2.sec.gov.ph/companyinformationlookup/1.0.0
SEC_API_KEY=

# DuckDuckGo search throttling (external verification)
DDG_MAX_CONCURRENT=2
DDG_MIN_INTERVAL=1.5
DDG_MAX_PER_VERIFY=10

# Client Authentication
# Extension sends this value as X-Trabahero-Client-Key header.
# Leave empty to disable auth (development mode).
# Required in production to prevent unauthorized API access.
CLIENT_SECRET_KEY=

# AI Concurrency Limits
AI_MAX_CONCURRENT=2
AI_MAX_QUEUE_DEPTH=10
AI_ACQUIRE_TIMEOUT=10.0
AI_CALL_TIMEOUT=120.0
