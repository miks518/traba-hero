# Backend configuration
HOST=0.0.0.0
PORT=8000

# LM Studio (the AI layer — handles OCR, web search, analysis)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
# Leave empty to auto-detect, or set to the exact model ID from /v1/models
MODEL_NAME=

# SEC Philippines API (https://gwwso2.sec.gov.ph/companyinformationlookup/1.0.0)
# Free "Company Information Lookup" subscription: https://portal.sec.gov.ph/
SEC_API_URL=https://gwwso2.sec.gov.ph/companyinformationlookup/1.0.0
SEC_API_KEY=
