# Backend configuration
HOST=0.0.0.0
PORT=8000

# AI API Configuration (LM Studio, OpenRouter, OpenAI, etc.)
# Set your AI API key here (e.g. for OpenRouter, OpenAI, or authenticated LM Studio)
AI_API_KEY=
AI_API_URL=http://localhost:1234/v1
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
# Leave empty to auto-detect, or set to the exact model ID from /v1/models
MODEL_NAME=
# Set to false to avoid sending system prompt if already configured on LM Studio/local model
SEND_SYSTEM_PROMPT=true

# AI Generation Controls (Knobs)
# Temperature: 0.0 (strictly deterministic) to 1.0+ (creative). Default: 0.2
AI_TEMPERATURE=0.2
# Top-P (nucleus sampling): 0.1 to 1.0. Default: 1.0
AI_TOP_P=1.0
# Max tokens allowed for AI responses. Default: 2048
AI_MAX_TOKENS=2048

# SEC Philippines API (https://gwwso2.sec.gov.ph/companyinformationlookup/1.0.0)
# Free "Company Information Lookup" subscription: https://portal.sec.gov.ph/
SEC_API_URL=https://gwwso2.sec.gov.ph/companyinformationlookup/1.0.0
SEC_API_KEY=
