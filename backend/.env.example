# Backend configuration
HOST=0.0.0.0
PORT=8000

# AI API Configuration (any OpenAI-compatible endpoint)
# Get a key at https://openrouter.ai/keys and pick a multimodal model at
# https://openrouter.ai/models (image scans require a vision-capable model).
AI_API_KEY=
AI_API_URL=https://openrouter.ai/api/v1
# Exact model ID from the provider's model list, e.g. deepseek/deepseek-flash-latest
MODEL_NAME=
# Set to false only if the endpoint already injects the system prompt
SEND_SYSTEM_PROMPT=true

# AI Generation Controls (Knobs)
# Temperature: 0.0 (strictly deterministic) to 1.0+ (creative). Default: 0.2
AI_TEMPERATURE=0.2
# Top-P (nucleus sampling): 0.1 to 1.0. Default: 1.0
AI_TOP_P=1.0
# Max tokens allowed for AI responses. Default: 2048
# NOTE: if your model is a reasoning model, it draws deliberation from this same
# budget, so a long think can consume all of it and return no answer at all.
# Raise this, or set AI_REASONING_MAX_TOKENS below to cap the thinking separately.
AI_MAX_TOKENS=2048
# Reasoning controls (OpenRouter's normalized `reasoning` parameter). Only sent
# when set, so leave blank unless you are on a reasoning model.
#
# AI_REASONING_ENABLED=false turns reasoning off entirely. This is the cleanest
# option and the one to try first. Some models do not support disabling it; if
# the provider rejects it the backend retries once without the parameter and
# stops sending it, so it is safe to try.
# AI_REASONING_EFFORT takes low | medium | high and reduces thinking at the
# source — the next best thing.
# AI_REASONING_MAX_TOKENS only truncates thinking, and a truncated reasoning
# phase can make some providers re-attempt, so prefer one of the two above.
# If you set AI_REASONING_ENABLED=false it overrides the other two, because a
# provider rejects a disabled reasoning combined with a high effort level.
#
# Whichever you choose, keep AI_MAX_TOKENS above the reasoning budget.
AI_REASONING_ENABLED=
AI_REASONING_MAX_TOKENS=0
AI_REASONING_EFFORT=

# Web search (Tavily). Free tier: https://tavily.com — 1,000 credits/month,
# no credit card required. One search per verification.
# A missing key makes every verification report a retrieval failure rather than
# a clean result, so the panel will say the search was unavailable.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# TAVILY_SEARCH_DEPTH takes basic | advanced. This is the credit knob.
#   basic    = 1 credit per search, narrower recall
#   advanced = 2 credits per search, broader recall
# Advanced finds more small Philippine employers whose only footprint is a
# city PESO page or a local job board, because Tavily's crawl index covers that
# long tail thinly. At 1,000 credits/month that is ~1,000 verifications on
# basic or ~500 on advanced. Set basic if the budget matters more than recall.
# An unrecognised value logs an error and falls back to advanced rather than
# sending the provider a depth it will reject.
TAVILY_SEARCH_DEPTH=advanced

# TAVILY_COUNTRY is Tavily's country *boost*, which prioritises results from
# that country without restricting the result set to it. Philippines is the
# point of the product. Leave blank to disable the boost and search unboosted;
# a blank value is dropped rather than sent as an empty country.
# TAVILY_COUNTRY=philippines

# Client Authentication
# Extension sends this value as X-Trabahero-Client-Key header.
# Leave empty to disable auth (development mode).
# Required in production to prevent unauthorized API access.
CLIENT_SECRET_KEY=

# AI Concurrency Limits
AI_MAX_CONCURRENT=2
AI_MAX_QUEUE_DEPTH=10
AI_ACQUIRE_TIMEOUT=10.0
AI_CALL_TIMEOUT=120.0
