WXT_API_BASE=https://traba-hero-production.up.railway.app

# http://localhost:8000 - for local backend
# https://traba-hero-production.up.railway.app - for online backend with AI API

# Where the footer's Privacy link opens. The Web Store requires a privacy policy
# URL for every listing, and no domain hosts one, so the value is pasted here
# when the policy exists — a public Google Doc or a GitHub-hosted page both work.
# Left empty, the footer keeps showing "Privacy" as inert text (AC-05).
# Build-time value: restart `npm run dev` after changing it.
WXT_PRIVACY_POLICY_URL=
